# Copy to .env (project root). backend/.env is also read, for older setups.

# ---------- Server (app + API on one port) ----------
PORT=5000
APP_URL=http://localhost:5000
# Only needed if *other* origins (e.g. a mobile app or another site) call the API. Comma-separated or *
CORS_ORIGIN=

# ---------- Auth ----------
# Use a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ---------- Database ----------
# Option A (used when set): full Postgres connection string, e.g. Neon
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require
DATABASE_URL=

# Option B: sqlite (default, zero setup) | mysql2 | pg
DB_CLIENT=sqlite
DB_FILENAME=./database/ems.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ems

# ---------- Default admin (used by the seeder) ----------
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=password
ADMIN_PHONE=9999999999
ADMIN_ADDRESS=Head Office

# ---------- Attendance ----------
# Business timezone used for "today" and the job schedule
APP_TIMEZONE=Asia/Kolkata
# Daily job: creates "present" entries for active monthly-fixed employees
ATTENDANCE_JOB_ENABLED=true
# Time the job runs every day (24-hour HH:MM, in APP_TIMEZONE). 08:30 = 8:30 am
ATTENDANCE_JOB_TIME=08:30
# Standard hours when an employee has no "fixed working hours/day"
ATTENDANCE_DEFAULT_HOURS=8
# Weekdays the job skips (0=Sun ... 6=Sat), comma-separated. Empty = every day
ATTENDANCE_WEEKLY_OFF=

# ---------- Frontend (optional) ----------
# Leave empty: the app calls /api on the same origin. Set only if the API lives elsewhere.
VITE_API_URL=
